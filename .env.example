# Copy to .env locally. Never commit real values.
# DATABASE_URL: Neon pooled connection (API at runtime).
# DATABASE_URL_DIRECT: Neon direct connection (Alembic + pipeline).
DATABASE_URL=
DATABASE_URL_DIRECT=
ALLOWED_ORIGINS=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO
# Optional. Default is ../config relative to backend/.
CONFIG_DIR=
